      "id": "dfe6ef51-3857-4a38-aa94-85570ee60dbd",
      "name": "PDF lesen",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        1540,
        200
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
