              "value": "<Teamname>",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b6cfe133-5b0f-4c7e-a818-d98e9ed00e8c",
      "name": "Kunde eintragen",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "epa_config_allgemein"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "kunde_id",
              "condition": "eq",
              "keyValue": "={{ $json.kunde_id }}"
            }
          ]
        },
        "limit": 1
      },
      "id": "6c80ddc9-44cf-45da-a3f4-c892da00fe5c",
      "name": "Kunde lesen",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        448,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://graph.microsoft.com/v1.0/teams/\" + JSON.parse($json.benachrichtigung).team_id + \"/channels\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftTeamsOAuth2Api",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 20000
        }
      },
      "id": "4b7143ea-7a1d-44b8-a2b9-82f0c3c914b8",
      "name": "Kanäle lesen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// ----- Node-Logik -----\nconst k = $('Kunde lesen').first().json;\nif (!k || !k.kunde_id) throw new Error('Kunde nicht in epa_config_allgemein gefunden');\nlet b = {};\ntry { b = JSON.parse(k.benachrichtigung); } catch (e) { b = {}; }\nif (!b.team_id) throw new Error('team_id fehlt in benachrichtigung');\nconst res = $input.first().json;\nif (res.statusCode !== 200) throw new Error('Kanäle konnten nicht gelesen werden: ' + JSON.stringify(res.body).slice(0, 200));\nconst vorh = (res.body && res.body.value) || [];\nconst soll = [\n  { art: 'anfragen', name: '1 Vollständige Anfragen', text: 'Anfragen, die vollständig sind und bearbeitet werden können' },\n  { art: 'rueckfragen', name: '2 Rückfragen', text: 'Alles, was auf eine Antwort oder Entscheidung wartet' },\n  { art: 'system', name: '3 Systemmeldungen', text: 'Warnungen, Eskalationen und Fehler des Agenten' },\n  { art: 'logs', name: '4 Logs', text: 'Protokoll: eine Abschlusskarte pro Vorgang' },\n];\nfunction rein(s) { return String(s).replace(/^\\d+\\s+/, '').toLowerCase(); }\nreturn soll.map(function (s) {\n  const f = vorh.find(function (x) { return rein(x.displayName) === rein(s.name); });\n  return { json: { team_id: b.team_id, art: s.art, name: s.name, beschreibung: s.text, kanal_id: f ? f.id : '', alt_name: f ? f.displayName : s.name } };\n});\n"
      },
      "id": "44756348-ed26-4f46-a984-5273ee884979",
      "name": "Kanäle planen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \"https://graph.microsoft.com/v1.0/teams/\" + $json.team_id + \"/channels\" }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftTeamsOAuth2Api",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 20000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ displayName: $json.kanal_id ? $json.alt_name : $json.name, description: $json.beschreibung, membershipType: \"standard\" }) }}"
      },
      "id": "62c5dc93-241d-4405-a234-0438056246fb",
      "name": "Kanal anlegen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// ----- Node-Logik -----\nconst plan = $('Kanäle planen').all().map(function (i) { return i.json; });\nconst antw = $input.all().map(function (i) { return i.json; });\nconst k = $('Kunde lesen').first().json;\nlet b = {};\ntry { b = JSON.parse(k.benachrichtigung); } catch (e) { b = {}; }\nconst ids = {};\nconst fehler = [];\nplan.forEach(function (p, i) {\n  const a = antw[i] || {};\n  const id = p.kanal_id || (a.body && a.body.id ? a.body.id : '');\n  if (id) ids[p.art] = id;\n  else fehler.push(p.name + ': ' + (a.body && a.body.error ? a.body.error.code + ' ' + a.body.error.message : 'keine Antwort'));\n});\nif (fehler.length) throw new Error('Kanäle nicht angelegt: ' + fehler.join(' | '));\nconst nb = Object.assign({}, b, { channel_id: ids.system });\nconst kunde = $('Kunde eintragen').first().json;\nreturn [{ json: {\n  kunde_id: k.kunde_id,\n  team_id: b.team_id,\n  team_name: kunde.team_name || '',\n  kanaele: JSON.stringify(ids),\n  log_channel_id: ids.logs,\n  benachrichtigung: JSON.stringify(nb),\n  kanal_ids: ids,\n} }];\n"
      },
