      "name": "Team umbenennen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1792,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// ----- Node-Logik -----\nconst e = $('Ergebnis sammeln').first().json;\nconst plan = $('Kanäle planen').all().map(function (i) { return i.json; });\nreturn plan.map(function (p) {\n  return { json: { url: 'https://graph.microsoft.com/v1.0/teams/' + e.team_id + '/channels/' + e.kanal_ids[p.art], name: p.name } };\n});\n"
      },
