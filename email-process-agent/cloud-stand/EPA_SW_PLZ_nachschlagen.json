  {
   "id": "64baea2d-9fdd-48a4-bcd8-7ee50bc51bfb",
   "name": "PLZ normalisieren",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    224,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "const roh = $input.first().json.plz_liste;\nconst liste = Array.isArray(roh) ? roh : [];\nconst sauber = [];\nfor (const x of liste) {\n  const s = String(x === null || x === undefined ? '' : x).trim();\n  if (/^[0-9]{5}$/.test(s) && !sauber.includes(s)) sauber.push(s);\n}\nconst l = sauber.slice(0, 3);\nreturn [{ json: { liste: l, p1: l[0] || '00000x', p2: l[1] || '00000x', p3: l[2] || '00000x' } }];"
   }
  },
  {
   "id": "c4e07587-8090-4319-b67e-b406f2323111",
