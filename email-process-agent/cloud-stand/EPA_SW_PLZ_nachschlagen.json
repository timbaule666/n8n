   "name": "Ergebnis bauen",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    672,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "const angefragt = $('PLZ normalisieren').first().json.liste;\nconst info = {};\nfor (const p of angefragt) info[p] = { gefunden: false };\nlet fehler = false;\nfor (const i of $input.all()) {\n  const j = i.json || {};\n  if (j.error) { fehler = true; continue; }\n  if (j.plz && info[j.plz]) info[j.plz] = { gefunden: true, ort: j.ort || '', bundesland: j.bundesland || '' };\n}\nreturn [{ json: { ok: !fehler, plz_info: fehler ? {} : info } }];"
   },
   "executeOnce": false
  }
